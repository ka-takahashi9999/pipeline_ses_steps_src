    "PublishFailureNotification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-northeast-1:166714029268:sns-ses-match-perf-alert",
        "Subject": "SES matching pipeline orchestration failed",
        "Message.$": "States.Format('code={} message={} run_id={} run_date={}', $.failure.code, $.failure.message, $.run_id, $.run_date)"
      },
      "ResultPath": "$.failure_notification_result",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.notification_error",
          "Next": "FailExecution"
        }
      ],
      "Next": "FailExecution"
    },
    "PublishAlreadyRunningNotification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-northeast-1:166714029268:sns-ses-match-perf-alert",
        "Subject": "SES matching pipeline skipped: already running",
        "Message.$": "States.Format('code=ALREADY_RUNNING message={} run_id={} run_date={}. EC2 was not stopped.', $.failure.message, $.run_id, $.run_date)"
      },
      "ResultPath": "$.failure_notification_result",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
