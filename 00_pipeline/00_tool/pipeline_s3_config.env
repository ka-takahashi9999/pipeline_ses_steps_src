#!/usr/bin/env bash

# Non-secret defaults. AWS credentials must be supplied by the EC2 IAM role.
: "${PIPELINE_S3_BUCKET:=technoverse}"
: "${PIPELINE_S3_BASE_PREFIX:=pipeline_ses_steps}"
: "${PIPELINE_STATUS_PREFIX:=pipeline-status}"
: "${PIPELINE_LOG_PREFIX:=pipeline-logs}"
: "${PIPELINE_AWS_REGION:=ap-northeast-1}"
: "${PIPELINE_SYSTEMD_USER:=ec2-user}"

export PIPELINE_S3_BUCKET
export PIPELINE_S3_BASE_PREFIX
export PIPELINE_STATUS_PREFIX
export PIPELINE_LOG_PREFIX
export PIPELINE_AWS_REGION
export PIPELINE_SYSTEMD_USER
