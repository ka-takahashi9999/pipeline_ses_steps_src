#!/usr/bin/env bash

# Non-secret defaults. AWS credentials must be supplied by the EC2 IAM role.
: "${PIPELINE_S3_BUCKET:=technoverse}"
: "${PIPELINE_S3_BASE_PREFIX:=pipeline_ses_steps}"
: "${PIPELINE_STATUS_PREFIX:=pipeline-status}"
: "${PIPELINE_LOG_PREFIX:=pipeline-logs}"
: "${PIPELINE_AWS_REGION:=ap-northeast-1}"
: "${PIPELINE_SYSTEMD_USER:=ec2-user}"

# Issue 2 deploymentと通常夜間運用のGOを分離する。1のときだけ08-5 Batch
# orchestration Phase Aへ入り、0では既存direct 08-5経路を維持する。
: "${ENABLE_08_5_BATCH_ORCHESTRATION:=0}"

# Portal同期用（80-8 / 80-9）。bucket / region は上の既存設定を再利用する。
# PORTAL_S3_PREFIX は bucket直下からの完全なkey prefix。
#
# 【重要】80-9 は `aws s3 sync --delete` の直前に destination安全ロックを行い、
#   bucket=technoverse / base prefix=pipeline_ses_steps /
#   portal prefix=pipeline_ses_steps/pipeline_ses_steps /
#   URI=s3://technoverse/pipeline_ses_steps/pipeline_ses_steps/
# と完全一致しない場合は sync開始前にFAILする。
# ここや環境変数を書き換えて --delete の範囲を上位prefixへ広げることはできない。
: "${PORTAL_S3_PREFIX:=${PIPELINE_S3_BASE_PREFIX}/pipeline_ses_steps}"
# sync完了後 verify までの待機秒数。非負整数のみ（0 / 30 / 60 など）。
: "${PORTAL_S3_VERIFY_WAIT_SEC:=30}"

# Portal backup（80-75）。CURRENT + bk1 の1世代backup（total 2 set）。
# 将来 bk2 / bk3 へ拡張する場合も CURRENT と同じ relative path を保つ。
#
# 【重要】80-75 は `aws s3 sync CURRENT BK1 --delete` の直前に destination安全ロックを行い、
#   source=s3://technoverse/pipeline_ses_steps/pipeline_ses_steps/
#   dest  =s3://technoverse/pipeline_ses_steps/pipeline_ses_steps_bk1/
# と完全一致しない場合は sync開始前にFAILする。
# ここや環境変数を書き換えて bucket root / private / pipeline-status / pipeline-logs /
# 別bucket / 任意prefix / bk2 / bk3 へ向けることはできない。
: "${PORTAL_S3_BACKUP_PREFIX:=${PIPELINE_S3_BASE_PREFIX}/pipeline_ses_steps_bk1}"

export PIPELINE_S3_BUCKET
export PIPELINE_S3_BASE_PREFIX
export PIPELINE_STATUS_PREFIX
export PIPELINE_LOG_PREFIX
export PIPELINE_AWS_REGION
export PIPELINE_SYSTEMD_USER
export ENABLE_08_5_BATCH_ORCHESTRATION
export PORTAL_S3_PREFIX
export PORTAL_S3_VERIFY_WAIT_SEC
export PORTAL_S3_BACKUP_PREFIX
