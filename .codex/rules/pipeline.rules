# Codex execpolicy rules (project scope) — Codex CLI 0.147.0
#
# 目的:
#   - 正規sync/git「実行用コピー」だけを無確認で自走可能にする
#   - 破壊的なGit操作を禁止する
#
# 有効な decision は allow / prompt / forbidden の3種のみ（0.147.0で実測確認済み）。
# 検証: codex execpolicy check --rules .codex/rules/pipeline.rules <command...>
#
# 制約（既知）:
#   prefix_rule は argv の先頭一致で判定するため、
#   `bash -lc "git push --force"` のようにシェル経由で包まれた場合は一致しない。
#   最終的な破壊操作の防止は「スクリプトにforce push機能を持たせない」設計側で担保する。

# --- 正規sync/git経路（実行用コピーのみ）---
# 正本 tools/pipeline_sync_git.sh は workspace 内でAIが編集可能なため allow しない。
# 「正本を書き換えて sandbox 外で無確認実行」という経路を作らないこと。
prefix_rule(pattern=["/home/ec2-user/bin/pipeline_sync_git.sh"], decision="allow")

# --- 破壊的Git操作は禁止 ---
prefix_rule(pattern=["git", "push", "--force"], decision="forbidden")
prefix_rule(pattern=["git", "push", "--force-with-lease"], decision="forbidden")
prefix_rule(pattern=["git", "push", "-f"], decision="forbidden")
prefix_rule(pattern=["git", "reset", "--hard"], decision="forbidden")
prefix_rule(pattern=["git", "clean"], decision="forbidden")

# --- git -C <_src> 形式の破壊操作も禁止（通常の status / diff / push は対象外）---
prefix_rule(pattern=["git", "-C", "/home/ec2-user/pipeline_ses_steps_src", "push", "--force"], decision="forbidden")
prefix_rule(pattern=["git", "-C", "/home/ec2-user/pipeline_ses_steps_src", "push", "--force-with-lease"], decision="forbidden")
prefix_rule(pattern=["git", "-C", "/home/ec2-user/pipeline_ses_steps_src", "push", "-f"], decision="forbidden")
prefix_rule(pattern=["git", "-C", "/home/ec2-user/pipeline_ses_steps_src", "reset", "--hard"], decision="forbidden")
prefix_rule(pattern=["git", "-C", "/home/ec2-user/pipeline_ses_steps_src", "clean"], decision="forbidden")
